# Copie para .env (que está no .gitignore) e preencha com as saídas do Terraform:
#   terraform -chdir=terraform output -raw database_url_admin
DATABASE_URL=postgresql://avnadmin:SENHA@HOST:PORTA/gap_salarial?sslmode=require

# Usuário somente leitura do painel (recebe GRANT SELECT na carga)
DASHBOARD_DB_USER=leitor_dashboard

# Opcional: OpenSearch criado no Console da Aiven
#   terraform -chdir=terraform output -raw opensearch_uri
OPENSEARCH_URI=
